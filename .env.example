# === AI Provider ===
# Gemini (GRATIS): daftar di https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# === Background image (Pexels, GRATIS) ===
# Dapat API key di https://www.pexels.com/api/ (wakilan otomatis per topik konten).
# Kosongkan jika tidak mau pakai foto background (fallback ke gradient).
PEXELS_API_KEY=

# === TikTok for Developers ===
# Dapat dari https://developers.tiktok.com
# Status saat ini: UNAUDITED (hanya draft ke tester akun)
# Coscopes: user.info.basic, video.publish, music.info.search, video.upload
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional: token bisa diisi di sini ATAU dapat otomatis via OAuth flow
# (login dari dashboard → /auth/tiktok/login). Token refresh/access baru
# disimpan otomatis ke data/tiktok_tokens.json oleh sistem.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Redirect URI harus cocok persis dengan yg didaftarkan di TikTok Developer Portal
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,video.publish,music.info.search,video.upload

# === TTS (gratis: edge-tts; alternatif: ElevenLabs berbayar) ===
TTS_PROVIDER=edge
TTS_VOICE=id-ID-GadisNeural
TTS_RATE=-8%      # kecepatan seimbang: natural tapi tidak melambat berlebihan
TTS_PITCH=+2Hz    # sedikit hangat, kurang monoton
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# === Notification (Telegram, opsional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Scheduler Config ===
# Format: HH:MM (24 jam)
SCHEDULE_SLOT_1=10:00
SCHEDULE_SLOT_2=19:00
TIMEZONE=Asia/Jakarta

# === TikTok Publish Mode ===
# false = upload sebagai draft/private (unaudited app)
# true  = publish publik langsung (hanya setelah audit disetujui)
AUTO_PUBLISH_PUBLIC=false
# true = pencatatan/tes pipeline TANPA upload sungguhan (publish_id berprefix DRYRUN-)
TIKTOK_DRY_RUN=false
# Seberapa sering (menit) cek konten yang jadwalnya sudah lewat untuk di-publish
PUBLISH_SWEEP_INTERVAL=5

# === App Config ===
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/contents.db
DEBUG=true
# Kosongkan untuk pakai binary ffmpeg bawaan (imageio-ffmpeg)
FFMPEG_PATH=
